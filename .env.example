# ---------------------------------------------------------------------------
# TryBooking daily ticket-sales report — configuration
# Copy this file to ".env" and fill in the real values. ".env" is gitignored
# so your credentials never get committed.
# ---------------------------------------------------------------------------

# --- TryBooking API credentials (from "Generate API key" dialog) ---------
# "Key"        -> TRYBOOKING_API_KEY   (used as the Basic-auth username)
# "Secret Key" -> TRYBOOKING_SECRET    (used as the Basic-auth password)
TRYBOOKING_API_KEY=your-key-here
TRYBOOKING_SECRET=your-secret-key-here

# API host. Leave as default unless TryBooking tells you otherwise.
TRYBOOKING_API_BASE=https://api.trybooking.com

# --- Email delivery (SMTP) ----------------------------------------------
# The daily report is emailed here.
REPORT_TO=shop@ssfnc.com.au
REPORT_FROM=reports@ssfnc.com.au

# Your outgoing mail server. Examples:
#   Gmail / Google Workspace : smtp.gmail.com  port 587  (use an App Password)
#   Microsoft 365            : smtp.office365.com port 587
#   Your host's mail server  : mail.ssfnc.com.au port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reports@ssfnc.com.au
SMTP_PASSWORD=your-smtp-app-password
# "tls" (STARTTLS, port 587), "ssl" (port 465), or "none"
SMTP_SECURITY=tls
